{
  "stryker-config": {
    "project": "ApplicationCore.csproj",
    "test-runner": "mtp",
    "target-framework": "net10.0",
    "mutate": [
      "**/Entities/BasketAggregate/Basket.cs"
    ],
    "mutation-level": "Standard",
    "coverage-analysis": "off",
